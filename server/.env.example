PORT=5000
CLIENT_URL=http://localhost:5173

# Atlas: Cluster → Connect → Drivers. Use your user, password (URL-encoded if special chars), and cluster host.
# Local dev: mongodb://127.0.0.1:27017/binflow
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/binflow?retryWrites=true&w=majority

JWT_SECRET=replace_with_a_long_random_string

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: bootstrap first admin via npm run seed:admin
ADMIN_EMAIL=admin@binflow.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=BinFlow Admin
